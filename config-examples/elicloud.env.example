# Copy to /etc/elicloud.env, chmod 600, and fill in real values
ELICLOUD_SECRET_KEY=generate-with-python-secrets.token_hex-32
ELICLOUD_ADMIN_HASH=generate-with-werkzeug-generate_password_hash

# Optional (defaults shown)
# ELICLOUD_MAX_UPLOAD_MB=100      # total size of one upload request
# ELICLOUD_COOKIE_SECURE=1        # set 0 only for plain-HTTP local testing
